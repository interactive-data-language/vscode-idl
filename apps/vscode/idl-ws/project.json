{
  "name": "vscode-idl-ws",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/vscode/idl-ws/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "idl-ws:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "idl-ws:build:development"
        },
        "production": {
          "buildTarget": "idl-ws:build:production"
        }
      }
    }
  }
}
