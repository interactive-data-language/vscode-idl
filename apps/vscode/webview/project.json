{
  "name": "vscode-webview",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/vscode/webview/src",
  "prefix": "idl",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/apps/vscode/webview",
          "browser": ""
        },
        "index": "apps/vscode/webview/src/index.html",
        "browser": "apps/vscode/webview/src/main.ts",
        "polyfills": ["apps/vscode/webview/src/polyfills.ts"],
        "tsConfig": "apps/vscode/webview/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/vscode/webview/src/favicon.ico",
          "apps/vscode/webview/src/assets"
        ],
        "styles": ["apps/vscode/webview/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/vscode/webview/src/environments/environment.ts",
              "with": "apps/vscode/webview/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "vscode-webview:build:production"
        },
        "development": {
          "buildTarget": "vscode-webview:build:development"
        }
      },
      "defaultConfiguration": "development",
      "continuous": true
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "vscode-webview:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/vscode/webview"],
      "options": {
        "jestConfig": "apps/vscode/webview/jest.config.ts",
        "tsConfig": "apps/vscode/webview/tsconfig.spec.json"
      }
    }
  }
}
