{
  "include": ["src/**/*.spec.pro"],
  "exclude": ["src/sol/test/**", "src/**/tmp_*/**"],
  "source": {
    "include": ["src/**/*.pro"],
    "exclude": ["src/**/*.spec.pro", "src/sol/test/**", "src/**/tmp_*/**"]
